#version 450

// 定义工作组大小，通常 16x16
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// 绑定 0: 原始环境贴图 (Source Cubemap)
layout(binding = 0) uniform samplerCube samplerEnv;

// 绑定 1: 目标 Mip Level 的写入视图 (Destination Storage Image)
// 格式必须与 C++ 中创建 image view 时的格式一致，例如 rgba16f
layout(binding = 1, rgba16f) uniform writeonly imageCube outImage;

// Push Constants
// 保持了你原有的 offset，方便 C++ 端复用结构体
layout(push_constant) uniform PushConsts {
    float roughness;
    uint numSamples;
} consts;

const float PI = 3.1415926536;

// ----------------------------------------------------------------------------
// 辅助函数：根据 Cube 面索引和 UV 坐标计算 3D 方向向量
// 对应 Vulkan Cubemap 的坐标系标准
// ----------------------------------------------------------------------------
vec3 getDirectionFromCubeFace(uint face, vec2 uv) {
    // uv 范围 [-1, 1]
    float u = uv.x;
    float v = uv.y;
    vec3 dir;
    
    switch(face) {
        case 0: dir = vec3( 1.0,   v,  -u); break; // POSITIVE_X
        case 1: dir = vec3(-1.0,   v,   u); break; // NEGATIVE_X
        case 2: dir = vec3(   u, 1.0,  -v); break; // POSITIVE_Y
        case 3: dir = vec3(   u,-1.0,   v); break; // NEGATIVE_Y
        case 4: dir = vec3(   u,   v, 1.0); break; // POSITIVE_Z
        case 5: dir = vec3(  -u,   v, -1.0); break; // NEGATIVE_Z
    }
    return normalize(dir);
}

// ----------------------------------------------------------------------------
// 你的原有 PBR 数学函数保持不变
// ----------------------------------------------------------------------------

float random(vec2 co)
{
    float a = 12.9898;
    float b = 78.233;
    float c = 43758.5453;
    float dt= dot(co.xy ,vec2(a,b));
    float sn= mod(dt,3.14);
    return fract(sin(sn) * c);
}

vec2 hammersley2d(uint i, uint N) 
{
    uint bits = (i << 16u) | (i >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    float rdi = float(bits) * 2.3283064365386963e-10;
    return vec2(float(i) /float(N), rdi);
}

vec3 importanceSample_GGX(vec2 Xi, float roughness, vec3 normal) 
{
    float alpha = roughness * roughness;
    // 注意：这里使用了 random(normal.xz)，这可能导致不同面的接缝处有噪点差异
    // 如果发现接缝问题，可以去掉 random 偏移，直接用 2.0 * PI * Xi.x
    float phi = 2.0 * PI * Xi.x + random(normal.xz) * 0.1;
    
    float cosTheta = sqrt((1.0 - Xi.y) / (1.0 + (alpha*alpha - 1.0) * Xi.y));
    float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
    vec3 H = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

    // Tangent space
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangentX = normalize(cross(up, normal));
    vec3 tangentY = normalize(cross(normal, tangentX));

    return normalize(tangentX * H.x + tangentY * H.y + normal * H.z);
}

float D_GGX(float dotNH, float roughness)
{
    float alpha = roughness * roughness;
    float alpha2 = alpha * alpha;
    float denom = dotNH * dotNH * (alpha2 - 1.0) + 1.0;
    return (alpha2)/(PI * denom*denom); 
}

vec3 prefilterEnvMap(vec3 R, float roughness)
{
    vec3 N = R;
    vec3 V = R;
    vec3 color = vec3(0.0);
    float totalWeight = 0.0;
    
    // 获取源纹理的基础尺寸
    float envMapDim = float(textureSize(samplerEnv, 0).s);
    
    for(uint i = 0u; i < consts.numSamples; i++) {
        vec2 Xi = hammersley2d(i, consts.numSamples);
        vec3 H = importanceSample_GGX(Xi, roughness, N);
        vec3 L = 2.0 * dot(V, H) * H - V;
        float dotNL = clamp(dot(N, L), 0.0, 1.0);
        
        if(dotNL > 0.0) {
            float dotNH = clamp(dot(N, H), 0.0, 1.0);
            float dotVH = clamp(dot(V, H), 0.0, 1.0);

            float pdf = D_GGX(dotNH, roughness) * dotNH / (4.0 * dotVH) + 0.0001;
            float omegaS = 1.0 / (float(consts.numSamples) * pdf);
            float omegaP = 4.0 * PI / (6.0 * envMapDim * envMapDim);
            float mipLevel = roughness == 0.0 ? 0.0 : max(0.5 * log2(omegaS / omegaP) + 1.0, 0.0f);
            
            color += textureLod(samplerEnv, L, mipLevel).rgb * dotNL;
            totalWeight += dotNL;
        }
    }
    return (color / totalWeight);
}

// ----------------------------------------------------------------------------
// Main
// ----------------------------------------------------------------------------
void main()
{
    // 获取当前线程处理的像素坐标 (x, y, face_index)
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    
    // 获取当前绑定的输出图像尺寸 (对应当前的 Mip Level)
    ivec2 size = imageSize(outImage);

    // 边界检查
    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    // 计算归一化的设备坐标 (-1 到 1)，并对齐到像素中心
    vec2 uv = (vec2(id.xy) + vec2(0.5)) / vec2(size) * 2.0 - 1.0;

    // 计算对应的世界空间方向向量 N
    vec3 N = getDirectionFromCubeFace(id.z, uv);

    // 执行预过滤计算
    vec3 result = prefilterEnvMap(N, consts.roughness);

    // 写入结果
    imageStore(outImage, id, vec4(result, 1.0));
}