#version 450

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout (binding = 0) uniform samplerCube samplerEnv;
layout (binding = 1, rgba16f) uniform writeonly imageCube outIrradianceMap;

layout (push_constant) uniform PushConsts {
    // 这里的参数可以改为 totalSamples，或者直接在 shader 里写死 4096
    float deltaPhi;   // 不再需要
    float deltaTheta; // 不再需要
} consts;

#define PI 3.1415926535897932384626433832795

// 采样次数：次数越高越精确，通常 1024 到 4096 之间足够
const uint SAMPLE_COUNT = 4096u;

// ----------------------------------------------------------------------------
// Hammersley 序列生成函数
// 用于生成均匀分布在 [0,1] 区间的伪随机点，比普通随机数更均匀，能有效消除条纹
// ----------------------------------------------------------------------------
float RadicalInverse_VdC(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10; // / 0x100000000
}

vec2 Hammersley(uint i, uint N)
{
    return vec2(float(i) / float(N), RadicalInverse_VdC(i));
}

// ----------------------------------------------------------------------------
// 坐标系辅助函数
// ----------------------------------------------------------------------------
vec3 getDirectionFromCubeFace(uint face, vec2 uv) {
    vec3 dir;
    switch (face) {
        case 0: dir = vec3(1.0, uv.y, -uv.x); break;
        case 1: dir = vec3(-1.0, uv.y, uv.x); break;
        case 2: dir = vec3(uv.x, 1.0, -uv.y); break;
        case 3: dir = vec3(uv.x, -1.0, uv.y); break;
        case 4: dir = vec3(uv.x, uv.y, 1.0); break;
        case 5: dir = vec3(-uv.x, uv.y, -1.0); break;
    }
    return normalize(dir);
}

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    ivec2 size = imageSize(outIrradianceMap);

    if (id.x >= size.x || id.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(id.xy) + vec2(0.5)) / vec2(size) * 2.0 - 1.0;
    vec3 N = getDirectionFromCubeFace(id.z, uv);

    // 1. 构建切线空间 (TBN)
    // 修正：增加对极点的判断，防止 cross 结果为 0 导致的错误
    vec3 up = abs(N.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 right = normalize(cross(up, N));
    up = cross(N, right);

    vec3 irradiance = vec3(0.0);

    // 2. 蒙特卡洛积分
    for (uint i = 0u; i < SAMPLE_COUNT; ++i)
    {
        // 获取低差异序列样本
        vec2 Xi = Hammersley(i, SAMPLE_COUNT);

        // 余弦加权采样 (Cosine-Weighted Sampling)
        // 这种采样方式生成的点在靠近法线方向(极点)更密集
        // 这样我们就不需要在循环里手动乘以 cos(theta) 了，公式会简化
        float phi = 2.0 * PI * Xi.x;
        float cosTheta = sqrt(1.0 - Xi.y);
        float sinTheta = sqrt(1.0 - cosTheta * cosTheta);

        // 转换到切线空间坐标
        vec3 tangentSample = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

        // 转换到世界空间
        vec3 sampleVec = tangentSample.x * right + tangentSample.y * up + tangentSample.z * N;

        // 采样环境图
        // 修正：在 Compute Shader 中必须使用 textureLod 指定 mip level 为 0
        // 这能避免由于导数未定义导致的采样伪影
        irradiance += textureLod(samplerEnv, sampleVec, 0.0).rgb;
    }

    // 3. 计算平均值
    // 由于使用了余弦加权采样，PDF = cos(theta) / PI
    // 积分公式变成了： (1/N) * sum( L * cos / PDF ) = (1/N) * sum( L * cos / (cos/PI) )
    //               = (PI/N) * sum( L )
    irradiance = irradiance / float(SAMPLE_COUNT);

    imageStore(outIrradianceMap, id, vec4(irradiance, 1.0));
}